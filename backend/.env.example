# ===== EnvAI Backend 环境变量示例 =====
# 复制为 .env 并按需修改（.env 禁止提交到仓库）

# 应用
APP_NAME=EnvAI
DEBUG=false

# 安全（复制后务必替换为强随机值，建议 32 字节以上）
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库（Docker Compose 与后端共用以下 POSTGRES_* 变量）
POSTGRES_USER=envai
POSTGRES_PASSWORD=REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD
POSTGRES_DB=envai
DATABASE_URL=postgresql+psycopg://envai:REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD@localhost:5433/envai

# 文件存储
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads
MAX_UPLOAD_FILE_SIZE_MB=20
MAX_UPLOAD_FILES_PER_REQUEST=10

# 文档解析限制
MAX_PDF_PAGES=500
SCANNED_PDF_MIN_TEXT_CHARS=100
MAX_DOCX_PARAGRAPHS=100000
MAX_TABLE_COUNT=1000
MAX_TABLE_ROWS=10000
MAX_EXCEL_SHEETS=20
MAX_EXCEL_ROWS=10000
MAX_EXCEL_COLUMNS=200
MAX_EXCEL_CELLS=2000000
MAX_ARCHIVE_UNCOMPRESSED_SIZE_MB=100
MAX_PLAIN_TEXT_CHARS=5000000
MAX_IMAGE_PIXELS=100000000

# Phase 3 AI（默认 mock；真实 Provider 使用 OpenAI-compatible /chat/completions）
AI_PROVIDER=mock
# 例如：https://api.example.com/v1 或本地 http://127.0.0.1:11434/v1
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30
AI_MAX_RETRIES=2
# OpenCode Go + DeepSeek V4 Flash should disable this because that gateway can
# return an empty JSON object when response_format=json_object is requested.
AI_JSON_MODE=true

# Phase 4 知识库（默认本地 Mock；真实 Provider 使用 OpenAI-compatible /embeddings）
EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-hash-v1
# 真实 Embedding 必须将 EMBEDDING_DIMENSION 改为模型实际输出维度
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_DIMENSION=64
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT=30
EMBEDDING_MAX_RETRIES=2
# 本机直接运行后端的 Ollama 示例：
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_API_KEY=ollama
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSION=1024
# Docker Desktop 开发环境将 EMBEDDING_BASE_URL 覆盖为
# http://host.docker.internal:11434/v1。
CHUNK_TARGET_TOKENS=420
CHUNK_MAX_TOKENS=600
CHUNK_OVERLAP_TOKENS=40
SEARCH_VECTOR_TOP_K=30
SEARCH_KEYWORD_TOP_K=30
SEARCH_FINAL_TOP_K=10

# CORS（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
